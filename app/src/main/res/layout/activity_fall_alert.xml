<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF3B30"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="120dp"
        android:height="120dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_dialog_alert"
        android:tint="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FALL DETECTED!"
        android:textColor="@android:color/white"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Are you okay?\nSending SOS to your guardian in:"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="15"
        android:textColor="@android:color/white"
        android:textSize="64sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCancelAlert"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="@android:color/white"
        android:text="I AM OKAY (CANCEL)"
        android:textColor="#FF3B30"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCallGuardian"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50"
        android:text="CALL GUARDIAN NOW"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
